# Copy to backend/.env (gitignored) and fill in. Entry points load it via
# pipeline.env.load_env(); a real environment variable always wins over a
# value here.
#
# Keep ANTHROPIC_API_KEY *out* of your machine's environment variables. An
# exported key is visible to every process on the box, including other
# Anthropic tooling that would then bill this project's API account instead of
# its own subscription. In backend/.env it reaches only this project.

# --- Postgres ---
# Dev database from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://user:password@localhost:5432/edgar_answers
# Separate database for the db-marked tests. Leave it unset and those tests
# skip; set it and Postgres must be up, or pytest blocks with no timeout.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/edgar_answers_test

# --- Anthropic ---
# Needed only to answer questions (POST /ask and the faithfulness eval).
# Ingestion, embedding, and retrieval cost nothing — embeddings run locally.
ANTHROPIC_API_KEY=

# --- EDGAR etiquette ---
# SEC requires a real identifying User-Agent on every request.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# --- API ---
# Origin allowed through CORS. Defaults to http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000

# /ask caps (api/limits.py). Defaults shown; local dev never hits them.
# ASK_PER_IP_PER_HOUR=20
# ASK_DAILY_CAP=200
# Header carrying the real client IP. Set ONLY behind a proxy that overwrites
# it (Fly-Client-IP on Fly) -- anywhere else a client could forge it.
# CLIENT_IP_HEADER=

# The frontend reads NEXT_PUBLIC_API_URL from frontend/.env.local instead —
# see frontend/.env.local.example. It is not read from this file.
